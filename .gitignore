*.log
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
*.tmp
.tmp/

# ---- Python（文档里的 pandas 示例可能产生）----
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

